      "parameters": {
        "jsCode": "const b = $('Validate + idempotency key').item.json;\nconst ex = $json;\nconst claim = {\n  claim_id: b.claim_id, policy_number: b.policy.policy_number,\n  loss_date: b.loss_date, reported_date: b.reported_date,\n  vehicle_id: b.vehicle_id, loss_location: b.loss_location || ex.loss_location,\n  peril: ex.peril, claimant_name: ex.claimant_name || b.policy.insured_name,\n  driver_name: ex.driver_name || ex.claimant_name,\n  claimed_amount: ex.claimed_amount, repair_estimate: ex.repair_estimate,\n  description: ex.description, driver_under_influence: ex.driver_under_influence,\n  business_use: ex.business_use, racing: ex.racing,\n  extraction_confidence: ex.extraction_confidence };\nreturn [{ json: { policy: b.policy, claim, narrate: true } }];"
      },
