        "jsCode": "const b = $json.body || {};\nconst missing = ['claim_id','policy','loss_date','reported_date','claim_text']\n  .filter(k => b[k] === undefined);\nreturn [{ json: { ...b, valid: missing.length === 0, missing,\n  claim_ref: 'CR-' + (b.claim_id || 'unknown') } }];"
      },
